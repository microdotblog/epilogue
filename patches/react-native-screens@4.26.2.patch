@@ -73,6 +73,15 @@ class RNSSplitAppearanceApplicator {
     splitHostController.primaryEdge = splitHost.primaryEdge
     splitHostController.showsSecondaryOnlyButton = splitHost.showSecondaryToggleButton
 
+    // Epilogue supplies a navigation stack inside each column. When all split
+    // toggles are disabled, the wrapper bars are empty and must not add a
+    // second row above those stacks' own bars.
+    if splitHost.displayModeButtonVisibility == .never && !splitHost.showSecondaryToggleButton {
+      for case let navigationController as UINavigationController in splitHostController.viewControllers {
+        navigationController.setNavigationBarHidden(true, animated: false)
+      }
+    }
+
     // Step 2.1 - validating column constraints
     validateColumnConstraints(
       minWidth: splitHost.minimumPrimaryColumnWidth,
diff --git a/ios/gamma/split/RNSSplitHostComponentView.mm b/ios/gamma/split/RNSSplitHostComponentView.mm
